
if [[ -n "$PS1" ]]; then
    fastfetch
fi

PROMPT_COMMAND='history -a; '"$PROMPT_COMMAND"

export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$HOME/Applications/depot_tools:$PATH"

backup() {
    cp -- "$1" "$1.bak"
}

copy() {
    if [[ $# -eq 2 && -d "$1" ]]; then
        local from="${1%/}"
        command cp -r -- "$from" "$2"
    else
        command cp -- "$@"
    fi
}


alias ls='ls -la --color=always --group-directories-first'
alias la='ls -a  --color=always --group-directories-first'
alias ll='ls -l  --color=always --group-directories-first'

alias fixpacman="sudo rm /var/lib/pacman/db.lck"
alias update='sudo cachyos-rate-mirrors && sudo pacman -Syu'
alias cleanup="paru -Rcs $(pacman -Qdtq)"
alias mirror="sudo cachyos-rate-mirrors"

alias tarnow='tar -acf '
alias untar='tar -zxvf '
alias wget='wget -c '

alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'
alias ......='cd ../../../../..'

alias dir='dir --color=auto'
alias vdir='vdir --color=auto'
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'

alias jctl="journalctl -p 3 -xb"

eval "$(starship init bash)"

